# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vanta"
# 32+ random bytes, e.g. `openssl rand -hex 32`
AUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CURRENCY="USD"

# Private storage. Local disk by default (outside /public). Set S3_BUCKET to use S3-compatible storage.
STORAGE_DIR="./storage"
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Payments (card option only appears when set). Card data never touches this server.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# AI design assistant (hidden unless set)
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"

# Privacy-friendly analytics (loaded only after cookie consent)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Seeded admin account
SEED_ADMIN_EMAIL="admin@vanta.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
